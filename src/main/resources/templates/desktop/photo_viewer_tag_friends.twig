{# @pebvariable name="friends" type="smithereen.model.User[]" #}
<a href="javascript:void(0)" data-user-id="{{ currentUser.id }}">{{ L('photo_tag_myself') }}</a>
{% for friend in friends %}
<a href="javascript:void(0)" data-user-id="{{ friend.id }}">{{ friend | name('full') }}</a>
{% endfor %}
<div class="noResults grayText" style="display: none">{{ L('photo_tag_not_found', {'name': ""}, {'link': {'class': "noResultsLink", 'href': "javascript:void(0)"} }) }}</div>