{% extends "page" %}
{% block content %}
{% include "mail_tabbar" %}
<div class="summaryWrap">
	<div class="summary">
		{{- L('mail_outbox_summary', {'count': totalItems}) }}
	</div>
	{% include "pagination" %}
</div>
<div>
{% for msg in items %}
<div class="mailMessageRow{{ msg.unread ? ' unread' : '' }}" id="msgRow{{ msg.idString }}">
	{%- set userID=msg.firstRecipientID %}
	{%- set user=users[userID] %}
	<a href="{{ profileURL(userID) }}" class="avaW">{{ user | pictureForAvatar('a') }}</a>
	<a href="/my/mail/with/{{ userID }}" class="msgInfo">
		<div class="name ellipsize">{{ user | name }}{% if msg.senderID==currentUser.id and (msg.to | length)>1 %} +{{ (msg.to | length)-1 }}{% endif %}</div>
		{% if onlines contains user.id and onlines[user.id].isOnline %}<div class="onlineText">{{ L('user_online') }}{% if onlines[user.id].mobile %}<span class="mobileOnlineIcon"></span>{% endif %}</div>{% endif %}
		<div class="time">{{ LD(msg.createdAt) }}</div>
	</a>
	<a href="/my/mail/with/{{ userID }}" class="msgContent">
		{% if msg.subject is not empty %}<div class="subject ellipsize">{{ msg.subject }}</div>{% endif %}
		<div class="text">{{ msg.textPreview }}</div>
	</a>
	<ul class="actionList">
		<li><a href="/my/mail/messages/{{ msg.idString }}/delete?csrf={{ csrf }}" data-ajax class="ajaxReplaceWithLoader">{{ L('delete') }}</a></li>
	</ul>
</div>
{% else %}
<div class="singleColumn">
	<div class="emptyState">
		{{- L('mail_outbox_empty') }}
	</div>
</div>
{% endfor %}
</div>
<div class="bottomSummaryWrap">{% include "pagination" %}</div>
{% endblock %}
