# Versions of libvips and everything linked into it. Sourced by build.sh.
# Kept in step with https://github.com/lovell/sharp-libvips/blob/main/versions.properties, which bumps these within days
# of each upstream release. VERSION_DE265 is ours: sharp-libvips does not decode HEIC.

VERSION_VIPS=8.18.7

VERSION_AOM=3.15.2
VERSION_ARCHIVE=3.8.10
VERSION_CGIF=0.5.4
VERSION_DE265=1.1.3
VERSION_EXIF=0.6.26
VERSION_EXPAT=2.9.0
VERSION_FFI=3.8.0
VERSION_GLIB=2.90.1
VERSION_HEIF=1.23.6
VERSION_HIGHWAY=1.4.0
VERSION_IMAGEQUANT=2.4.1
VERSION_LCMS=2.19.1
# mozjpeg has had no release since 4.1.5, so sharp-libvips pins a commit on main
VERSION_MOZJPEG=0826579
VERSION_PNG=1.6.59
VERSION_WEBP=1.6.0
VERSION_ZLIB_NG=2.3.3
